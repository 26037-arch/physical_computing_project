// ===== 원본: cube.h =====
// cube.h — 3x3 큐브의 큐비(cubie) 모델과 회전 표기. sim/cube.js 와 같은 규약. (수학 정리: docs/MATH.md 1~2절)
//
// [상태] s = (σc, oc, σe, oe),  σc ∈ S8, oc ∈ Z3^8, σe ∈ S12, oe ∈ Z2^12
//   cp[i] = σc(i) : 위치 i 에 놓인 코너 조각 번호,  co[i] = oc(i) : 그 조각의 시계 방향 꼬임 (0,1,2)
//   ep[i] = σe(i), eo[i] = oe(i) : 엣지도 같음 (방향 0,1).  풀린 상태 = σ 항등, o = 0
//   물리적 제약: Σoc ≡ 0 (mod 3), Σoe ≡ 0 (mod 2), sgn σc = sgn σe
//   → 상태 수 8!·3^8·12!·2^12 / (3·2·2) ≈ 4.3×10^19
//
// [수] 한 수 M 도 같은 꼴 (σ^M, o^M). 상태 s 에 M 을 적용한 s·M 은
//   (s·M)σ(i) = σ(σ^M(i)),   (s·M)o(i) = o(σ^M(i)) + o^M(i)  (mod 3 / mod 2)
//   "수 뒤에 위치 i 로 오는 조각 = 원래 σ^M(i) 에 있던 조각, 방향 = 그 조각 방향 + M 이 더하는 꼬임".
//   이 곱은 결합적이라 18수가 루빅스 큐브 군을 생성한다. M^4 = id, M^-1 = M^3.
//   수 번호 m = 3f + (k-1).  f: U=0 R=1 F=2 D=3 L=4 B=5,  k=1 시계 90°, 2 180°, 3 반시계 90°
//   tables.h 의 MOVE_CP/CO/EP/EO[m] 가 σ^M, o^M (M_{3f+1} = M_{3f}^2, M_{3f+2} = M_{3f}^3 로 생성).

enum Face : uint8_t { FACE_U = 0, FACE_R, FACE_F, FACE_D, FACE_L, FACE_B };

struct Cube {
  uint8_t cp[8], co[8], ep[12], eo[12];

  Cube() { reset(); }
  void reset();
  void move(uint8_t m);                              // 한 수 적용
  void apply(const uint8_t* seq, uint8_t n);         // 수열 적용
  bool isSolved() const;
  uint8_t edgeState(uint8_t cubie) const;            // 위치*2 + 방향 (0..23)
  uint8_t cornerState(uint8_t cubie) const;          // 위치*3 + 방향 (0..23)
  void facelets(char* out54) const;                  // 54 스티커 문자 'URFDLB' (시뮬레이터 동기화용)
};

// ---- 표기 ----
void moveName(uint8_t m, char* out);                 // out 에 "U", "U2", "U'" (널 포함 3바이트)
void printSeq(Print& p, const uint8_t* seq, uint8_t n);
int8_t parseMove(const char* tok);                   // "R'" → 수 번호, 실패 -1
uint8_t parseSeq(const char* str, uint8_t* out, uint8_t maxN);
uint8_t simplifySeq(uint8_t* seq, uint8_t n);        // 같은 면 연속 합치기, 새 길이 반환
void scrambleSeq(uint32_t seed, uint8_t* out, uint8_t n); // xorshift32 섞기 (sim/cube.js 와 동일 수열)

// ===== 원본: solver.h =====
// solver.h — CFOP 4단계 풀이기 (sim/solver.js 와 같은 알고리즘·같은 순서 → 같은 풀이 문자열)
//   Cross : IDA* 18수, 휴리스틱 = 크로스 엣지 쌍 거리표 6개의 최댓값. 크로스 엣지 4개의 상태만 추적.
//   F2L   : 사람의 직관 F2L 처럼 매크로 수만 쓴다 — U 회전 3가지 + 트리거 X U^k X' (슬롯마다 2종류 × k 3가지).
//           트리거는 정의상 크로스와 다른 슬롯을 보존하므로 탐색 상태는 끼우는 쌍 (코너, 엣지) 2바이트뿐이고
//           F2L_PAIR 는 그 매크로 그래프의 정확한 최단 거리(겉면 수)다. 완성된 슬롯의 트리거는 금지.
//           쌍 선택은 그리디: 거리표 값이 작은 슬롯부터, 한계를 1씩 올리며 후보를 번갈아 본다.
//   OLL/PLL : 플래시의 인식 키 조회 (사전 AUF 4가지), PLL 은 공식 뒤 AUF 포함
//
// [수학적 근거 요약 — docs/MATH.md 3~7절]
//  사영   π_x(s) = (p, o) 는 등변: π_x(s·M) = T_M(π_x(s)),  T_M(p,o) = ((σ^M)^-1(p), o + o^M((σ^M)^-1(p)))
//          → 조각당 1바이트만 갱신해도 휴리스틱이 전체 상태로 계산한 것과 같다.
//  크로스 거리표 d_P(u) = 조각 집합 P 의 사영 그래프에서 목표까지의 BFS 거리. 실제 L수 해의 사영 경로도 길이 L 이므로
//          h_P(s) = d_P(π_P(s)) ≤ d*(s).  허용적 h 의 최댓값도 허용적: h = max_P h_P ≤ d*.
//  IDA*   f = g + h ≤ bound. 같은 면 연속 금지(X^a X^b = X^(a+b)), 반대면은 가환(UD = DU)이라 한 순서만 →
//          분기 18 → 평균 ≈ 13.3, bound +1 마다 비용 ≈ 13배. 허용적 h 이므로 처음 찾는 해가 (허용 수 집합 안에서) 최단.
//  F2L    켤레 X U^k X^-1 은 X 가 U층으로 올린 조각(슬롯 하나의 코너·엣지)과 U층만 바꾼다 → 크로스·다른 슬롯 보존.
//          매크로 그래프(간선 비용 1·3) 의 최단 거리를 표로 두면 h 가 정확해 탐색이 거의 직진한다 (한 쌍 수백 노드).
//  OLL    A 적용 후 방향 o'(i) = o(σ^A(i)) + o^A(i) 는 위치와 무관한 방향 벡터의 아핀 함수 →
//          s·r·A 가 방향 0  ⇔  key_OLL(s·r) = key_OLL(I·A^-1).  표에는 풀린 큐브에 A^-1 을 적용한 키를 저장.
//  PLL    s·r·A·u = I  ⇔  s·r = u^-1·A^-1.  표에는 (A, u) 마다 key_PLL(I·u^-1·A^-1) 저장 (21×4 + AUF 3 = 87).

#define SOL_MAX 128     // 전체 풀이 최대 수
#define STAGE_MAX 40    // 단계 하나의 최대 수

// 단계가 끝날 때마다 호출: 이름("CROSS","F2L FR","OLL 23","PLL Jb"), 수열, 탐색 노드 수, 소요 ms
typedef void (*StageCallback)(const char* name, const uint8_t* moves, uint8_t n, uint32_t nodes, uint32_t ms);

class Solver {
 public:
  uint32_t nodes = 0;
  // 성공하면 out[0..outLen) 에 전체 풀이(같은 면 연속 합침). 실패(비정상 상태)면 false
  bool solve(const Cube& start, uint8_t* out, uint8_t& outLen, StageCallback cb);

 private:
  // ---- Cross ----
  uint8_t path[16], pathLen = 0;    // IDA* 결과
  uint8_t crossA[6], crossB[6];
  uint8_t hCross(const uint8_t* es, uint8_t limit) const;
  bool childFits(const uint8_t* es, uint8_t* es2, uint8_t m, uint8_t limit, uint8_t& h) const;
  bool searchCross(const uint8_t* es, uint8_t g, uint8_t remaining, int8_t lastFace);
  bool idaCross(const uint8_t* es, uint8_t maxBound);
  // ---- F2L (매크로 수 27개: 0..2 = U U2 U', 3 + (slot*2+fam)*3 + k = 트리거 X U^(k+1) X') ----
  uint8_t mpath[12], mpathLen = 0;  // 매크로 번호열
  static uint8_t macroMoves(uint8_t i, uint8_t* out);           // 매크로의 겉면 수열, 길이(1 또는 3) 반환
  static uint8_t macroKind(uint8_t i);                           // 같은 종류(연속 금지) 판정용: U = 0xFF, 트리거 = slot*2+fam
  bool searchF2L(uint8_t cs, uint8_t es, uint8_t g, uint8_t depth, uint8_t bound, int8_t last, const uint8_t* table, uint8_t allowedMask);
  // ---- OLL / PLL ----
  bool lookupOLL(const Cube& c, uint8_t* out, uint8_t& n, char* name);
  bool lookupPLL(const Cube& c, uint8_t* out, uint8_t& n, char* name);
};

// ===== 원본: motors.h =====
// motors.h — V5 스텝모터 제어: 컵(홀더) 모터 1개(NEMA17 + A4988 직결). 후드 닫힘이면 아래 층, 열림이면 큐브 전체가 돈다.
//   A4988 은 1/4 마이크로스텝(MS2 → 5 V): 90° = STEPS_PER_QUARTER = 200 스텝, 1 스텝 = 0.45°.
//     풀스텝(1.8°)으로는 컵 여유(±2.05°)·전원 인가 때 로터가 튀는 양(최대 ±3.6°)을 보정할 수 없고 저속 공진이 크다.
//     MS2 를 꽂지 않은 풀스텝 배선이면 MICROSTEP 을 1 로 바꾼다(다른 상수는 따라 바뀐다).
//   등가속 램프(D. Austin 2005: c0 = 0.676·√(2/a), c_n = c_{n-1} − 2·c_{n-1}/(4n+1)): 가속도가 전 구간에서 같아
//     토크가 가장 작은 고속 구간에 부하가 몰리지 않는다(탈조 = 영구 위치 오차를 막는 첫 번째 수단 — 센서가 없다).
//     남은 스텝이 지금까지 가속한 스텝 수 이하가 되면 같은 곡선을 거꾸로 따라 감속한다. 90° 약 0.2 s, 180° 약 0.3 s.
//   컵·후드 여유를 흡수하는 오버슈트·중심 맞춤 왕복은 Mechanism 이 한다 (mechanism.h).
//   방향: CW_LEVEL 이면 컵이 위에서 봐서 시계 방향 (docs/HARDWARE_V5.md 3.2절). 실물 배선에 따라 한 줄로 반전.

class Motors {
 public:
  void begin();
  void rotate(uint16_t steps, bool cwFromAbove);   // 등가속 회전 후 바로 반환 — 정착 지연은 호출자가 준다 (가상 모드면 즉시 반환)
  void setEnabled(bool on) { enabled = on; }       // false 면 모터 신호 없이 즉시 반환 (가상 모드)
  bool isEnabled() const { return enabled; }
  void hold(bool on);                              // A4988 ENABLE (LOW = 켬). 끄면 로터가 풀려 컵 영점을 잃는다 — 운전 중에는 끄지 않는다
  uint16_t lastMoveMs = 0;                         // 마지막 회전 시간(ms)

 private:
  bool enabled = true;
  void pulse(uint16_t gapUs);
  void setDir(bool cw);
};

